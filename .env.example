# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Never commit .env.local. Never put the secret/service-role key in a
# NEXT_PUBLIC_* variable — that ships it to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses Row Level Security. Set it in Vercel with
# `vercel env add SUPABASE_SERVICE_ROLE_KEY` so it never touches a file in git.
SUPABASE_SERVICE_ROLE_KEY=
