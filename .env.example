# Copy to .env.local. Never commit .env.local.
# These two are publishable and ship to the browser by design; row-level
# security decides what they can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses row-level security, and is the only way to reach
# grant_submissions / investment_submissions. Never put it in a NEXT_PUBLIC_*
# variable. Set it with:  vercel env add SUPABASE_SECRET_KEY production
SUPABASE_SECRET_KEY=
